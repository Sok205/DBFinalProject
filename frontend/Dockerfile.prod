# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .

# Build the production bundle
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration as a template for dynamic PORT injection
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Default port for local testing
ENV PORT=80

# We use the standard nginx image's entrypoint which handles templates automatically
CMD ["nginx", "-g", "daemon off; worker_processes 2;"]
