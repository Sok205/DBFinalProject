FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    postgresql-client \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install uv && \
    uv pip install --system -r pyproject.toml

COPY . .

# Create static directory and ensure entrypoint is executable
RUN mkdir -p /app/static /app/staticfiles && \
    chmod +x /app/entrypoint.sh

# EXPOSE 8000 (Railway handles this dynamically)

ENTRYPOINT ["/app/entrypoint.sh"]

# Production: Use gunicorn binding to dynamic $PORT
CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 4 --threads 2 DBFinal.wsgi:application
